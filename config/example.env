# Server Configuration
PORT=3000

# Session Configuration
SESSION_ID=session1
API_KEY=your-secure-api-key-here

# Authentication Directory
# whatsapp-web.js uses LocalAuth strategy to store session data
AUTH_DIR=./auth_session1
QR_FILE=./qr.txt

# Chrome/Chromium Configuration
# Path to Chrome/Chromium executable (optional, auto-detects if not set)
# CHROME_PATH=/usr/bin/google-chrome

# Keepalive & Reconnect Configuration
# How often to send keepalive ping (in milliseconds)
KEEPALIVE_INTERVAL=60000
# Delay before reconnection attempt (in milliseconds)
REINIT_DELAY=3000
# Maximum number of reconnection attempts
MAX_RECONNECT_ATTEMPTS=10

# Logging
DEBUG=false

# Version
APP_VERSION=2.0.0
